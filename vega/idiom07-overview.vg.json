{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Idiom 07 side chart: share of all council areas whose rescues rose, stayed the same or fell between 2018-19 and 2024-25 (author-calculated). Source: NSW DCCEEW dashboard.",
  "width": "container",
  "height": 14,
  "padding": 0,
  "autosize": { "type": "fit-x", "contains": "padding" },
  "background": null,
  "data": {
    "url": "data/rescue_counts_by_lga.csv",
    "format": { "type": "csv", "parse": { "financial_year": "string", "rescue_count": "number" } }
  },
  "transform": [
    { "filter": "datum.lga_name !== 'LGA not recorded' && isValid(datum.rescue_count)" },
    { "filter": { "field": "financial_year", "oneOf": ["2018/19", "2024/25"] } },
    { "pivot": "financial_year", "value": "rescue_count", "groupby": ["lga_name"] },
    { "filter": "isValid(datum['2018/19']) && isValid(datum['2024/25'])" },
    {
      "calculate": "datum['2024/25'] > datum['2018/19'] ? 'Rose' : datum['2024/25'] < datum['2018/19'] ? 'Fell' : 'Same'",
      "as": "dir"
    },
    { "aggregate": [{ "op": "count", "as": "n" }], "groupby": ["dir"] },
    { "joinaggregate": [{ "op": "sum", "field": "n", "as": "all" }] },
    { "calculate": "100 * datum.n / datum.all", "as": "pct" },
    { "calculate": "indexof(['Rose', 'Same', 'Fell'], datum.dir)", "as": "o" }
  ],
  "mark": { "type": "bar", "stroke": "#FFFFFF", "strokeWidth": 2 },
  "encoding": {
    "x": { "field": "n", "type": "quantitative", "stack": "normalize", "axis": null },
    "order": { "field": "o" },
    "color": {
      "field": "dir",
      "type": "nominal",
      "scale": { "domain": ["Rose", "Same", "Fell"], "range": ["#A0286C", "#D6DAD7", "#8FA0A9"] },
      "legend": null
    },
    "tooltip": [
      { "field": "dir", "type": "nominal", "title": "Direction" },
      { "field": "n", "type": "quantitative", "title": "Council areas" },
      { "field": "pct", "type": "quantitative", "title": "Share (%)", "format": ".1f" }
    ]
  },
  "config": { "view": { "stroke": null }, "font": "Atkinson Hyperlegible, system-ui, sans-serif" }
}
