                "strokeWidth": 0.5,
                "clip": false
              }
            },
            {
              "name": "lgaMain",
              "mark": {
                "type": "geoshape",
                "stroke": "#ffffff",
                "strokeWidth": 0.5,
                "clip": false,
                "cursor": "pointer"
              },
              "encoding": {
                "shape": { "field": "geo", "type": "geojson" },
                "color": {
                  "condition": { "test": "datum.count === null", "value": "#E6E1D6" },
                  "field": "count",
                  "type": "quantitative",
                  "title": "Rescues",
                  "scale": {
                    "type": "threshold",
                    "domain": [100, 250, 500, 1000, 2000, 4000],
