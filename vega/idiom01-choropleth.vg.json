{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Idiom 01: choropleth of recorded wildlife rescues by NSW council area (LGA) and financial year, with a Sydney and Central Coast close-up and a linked top-5 bar chart. Fixed classes so colours compare between years. Source: NSW DCCEEW, NSW Wildlife Rehabilitation Data Dashboard; boundaries: NSW Spatial Services.",
  "data": {
    "url": "data/rescue_counts_by_lga.csv",
    "format": { "type": "csv", "parse": { "financial_year": "string", "rescue_count": "number" } }
  },
  "params": [
    {
      "name": "selected_year",
      "value": "2024/25",
      "bind": {
        "input": "select",
        "options": [
          "2013/14", "2014/15", "2015/16", "2016/17", "2017/18", "2018/19", "2019/20", "2020/21",
          "2021/22", "2022/23", "2023/24", "2024/25"
        ],
        "labels": [
          "2013–14", "2014–15", "2015–16", "2016–17", "2017–18", "2018–19", "2019–20", "2020–21",
          "2021–22", "2022–23", "2023–24", "2024–25"
        ],
        "name": "Financial year ",
        "element": "#fy-control"
      }
    },
    {
      "name": "hover",
      "select": { "type": "point", "fields": ["lga_name"], "on": "mouseover", "clear": "mouseout" },
      "views": ["lgaMain", "lgaInset"]
    },
    {
      "name": "pick",
      "select": { "type": "point", "fields": ["lga_name"], "on": "click", "clear": "dblclick" },
      "views": ["lgaMain", "lgaInset", "topBars"]
    }
  ],
  "align": "none",
  "center": false,
  "columns": 1,
  "concat": [
    {
      "width": 960,
      "height": 22,
      "title": {
        "text": "Number of rescues",
        "anchor": "start",
        "fontSize": 13,
        "fontWeight": 700,
        "offset": 6
      },
      "data": {
        "values": [
          { "label": "Under 100", "colour": "#E6F2EF", "i": 0 },
          { "label": "100–249", "colour": "#C2E0D8", "i": 1 },
          { "label": "250–499", "colour": "#93C7B9", "i": 2 },
          { "label": "500–999", "colour": "#5FA897", "i": 3 },
          { "label": "1,000–1,999", "colour": "#348676", "i": 4 },
          { "label": "2,000–3,999", "colour": "#176B60", "i": 5 },
          { "label": "4,000+", "colour": "#0B4A42", "i": 6 },
          { "label": "No records", "colour": "#E6E1D6", "i": 7 }
        ]
      },
      "transform": [{ "calculate": "datum.i * 120", "as": "x" }],
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": { "domain": [0, 960], "nice": false, "zero": false },
          "axis": null
        },
        "y": { "datum": 0.5, "type": "quantitative", "scale": { "domain": [0, 1] }, "axis": null }
      },
      "layer": [
        {
          "mark": {
            "type": "square",
            "size": 196,
            "opacity": 1,
            "stroke": "rgba(0,0,0,0.15)",
            "strokeWidth": 1,
            "xOffset": 7
          },
          "encoding": { "color": { "field": "colour", "type": "nominal", "scale": null } }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "dx": 20,
            "fontSize": 12,
            "color": "#25332F"
          },
          "encoding": { "text": { "field": "label" } }
        }
      ]
    },
    {
      "hconcat": [
        {
          "width": 640,
          "height": 450,
          "title": {
            "text": "Wildlife rescues by council area",
            "subtitle": "Darker areas had more rescues. Numbers 1 to 5 mark the top five.",
            "anchor": "start"
          },
          "transform": [
            { "filter": "datum.lga_name !== 'LGA not recorded'" },
            { "filter": "datum.financial_year === selected_year" },
            {
              "calculate": "isValid(datum.rescue_count) ? datum.rescue_count : null",
              "as": "count"
            },
            { "calculate": "datum.count === null ? -1 : datum.count", "as": "count_sort" },
            {
              "window": [{ "op": "rank", "as": "rank" }],
              "sort": [{ "field": "count_sort", "order": "descending" }]
            },
            {
              "joinaggregate": [
                { "op": "sum", "field": "count", "as": "mapped_total" },
                { "op": "valid", "field": "count", "as": "lgas_with_data" }
              ]
            },
            {
              "calculate": "datum.count === null ? null : datum.count / datum.mapped_total",
              "as": "share"
            },
            {
              "calculate": "datum.count === null ? 'No records' : format(datum.count, ',')",
              "as": "count_label"
            },
            {
              "calculate": "datum.count === null ? '–' : datum.rank + ' of ' + datum.lgas_with_data",
              "as": "rank_label"
            },
            { "calculate": "replace(datum.financial_year, '/', '–')", "as": "fy_label" },
            { "calculate": "datum.lga_name + '  ' + format(datum.count, ',')", "as": "short_label" },
            {
