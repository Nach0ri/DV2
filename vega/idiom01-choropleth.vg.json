                },
                "key": "properties.lga_name"
              },
              "as": "geo"
            },
            { "filter": "isValid(datum.geo)" },
            { "calculate": "datum.geo.properties.lx", "as": "lx" },
            { "calculate": "datum.geo.properties.ly", "as": "ly" }
          ],
          "projection": {
            "type": "conicEqualArea",
            "rotate": [-147, 0],
            "parallels": [-29, -36],
            "fit": {
              "type": "Feature",
