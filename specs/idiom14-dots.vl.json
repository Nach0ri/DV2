{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dot density map of 2024-25 wildlife rescues in NSW: 1 dot = 25 rescues, placed at random within each council area (positions generated once offline with a fixed seed). Source: NSW DCCEEW Wildlife Rehabilitation Data Dashboard.",
  "params": [
    {
      "name": "area_hover",
      "select": {
        "type": "point",
        "fields": [
          "lga_name"
        ],
        "on": "mouseover",
        "clear": "mouseout"
      },
      "views": [
        "dotAreasMain",
        "dotAreasInset"
      ]
    }
  ],
  "hconcat": [
    {
      "width": 540,
      "height": 400,
      "title": {
        "text": "How concentrated are rescues? 2024–25",
        "subtitle": "1 dot = 25 rescues. Hover an area for its count.",
        "anchor": "start"
      },
      "projection": {
        "type": "conicEqualArea",
        "rotate": [
          -147,
          0
        ],
        "parallels": [
          -29,
          -36
        ],
        "fit": {
          "type": "Feature",
          "properties": {},
          "geometry": {
            "type": "Polygon",
            "coordinates": [
              [
                [
                  140.9,
                  -28.1
                ],
                [
                  153.7,
                  -28.1
                ],
                [
                  153.7,
                  -37.6
                ],
                [
                  140.9,
                  -37.6
                ],
                [
                  140.9,
                  -28.1
                ]
              ]
            ]
          }
        }
      },
      "layer": [
        {
          "data": {
            "url": "data/nsw_lga.geojson",
            "format": {
              "type": "json",
              "property": "features"
            }
          },
          "transform": [
            {
              "filter": "datum.properties.lga_name !== \"Lord Howe Island (unincorporated)\""
            }
          ],
          "mark": {
            "type": "geoshape",
            "fill": "#F1F2EE",
            "stroke": "#C9CFCB",
            "strokeWidth": 0.5
          }
        },
        {
          "name": "dotAreasMain",
          "data": {
            "url": "data/rescue_counts_by_lga.csv",
            "format": {
              "type": "csv",
              "parse": {
                "financial_year": "string",
                "rescue_count": "number"
              }
            }
          },
          "transform": [
            {
              "filter": "datum.financial_year === \"2024/25\" && datum.lga_name !== \"LGA not recorded\" && datum.lga_name !== \"Lord Howe Island (unincorporated)\""
            },
            {
              "calculate": "round(datum.rescue_count / 25)",
              "as": "dots"
            },
            {
              "lookup": "lga_name",
              "from": {
                "data": {
                  "url": "data/nsw_lga.geojson",
                  "format": {
                    "type": "json",
                    "property": "features"
                  }
                },
                "key": "properties.lga_name"
              },
              "as": "geo"
            }
          ],
          "mark": {
            "type": "geoshape",
            "fill": "#F1F2EE"
          },
          "encoding": {
            "shape": {
              "field": "geo",
              "type": "geojson"
            },
            "stroke": {
              "condition": {
                "param": "area_hover",
                "empty": false,
                "value": "#25332F"
              },
              "value": "#C9CFCB"
            },
            "strokeWidth": {
              "condition": {
                "param": "area_hover",
                "empty": false,
                "value": 1.6
              },
              "value": 0.5
            },
            "tooltip": [
              {
                "field": "lga_name",
                "type": "nominal",
                "title": "Council area"
              },
              {
                "field": "rescue_count",
                "type": "quantitative",
                "title": "Rescues 2024–25",
                "format": ","
              },
              {
                "field": "dots",
                "type": "quantitative",
                "title": "Dots shown (rounded)"
              }
            ]
          }
        },
        {
          "data": {
            "url": "data/rescue_dots_2024_25.csv",
            "format": {
              "type": "csv",
              "parse": {
                "lon": "number",
                "lat": "number"
              }
            }
          },
          "mark": {
            "type": "circle",
            "size": 4,
            "color": "#0B4A42",
            "opacity": 0.7
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            }
          }
        },
        {
          "data": {
            "values": [
              {
                "type": "Feature",
                "properties": {},
                "geometry": {
                  "type": "Polygon",
                  "coordinates": [
                    [
                      [
                        150.55,
                        -32.98
                      ],
                      [
                        152.15,
                        -32.98
                      ],
                      [
                        152.15,
                        -34.25
                      ],
                      [
                        150.55,
                        -34.25
                      ],
                      [
                        150.55,
                        -32.98
                      ]
                    ]
                  ]
                }
              }
            ]
          },
          "mark": {
            "type": "geoshape",
            "filled": false,
            "stroke": "#A0286C",
            "strokeWidth": 1.2,
            "strokeDash": [
              4,
              3
            ]
          }
        }
      ]
    },
    {
      "width": 260,
      "height": 320,
      "title": {
        "text": "Sydney and Central Coast",
        "subtitle": "Close-up of the dashed box (same dot value)",
        "anchor": "start"
      },
      "projection": {
        "type": "conicEqualArea",
        "rotate": [
          -147,
          0
        ],
        "parallels": [
          -29,
          -36
        ],
        "fit": {
          "type": "Feature",
          "properties": {},
          "geometry": {
            "type": "Polygon",
            "coordinates": [
              [
                [
                  150.55,
                  -32.98
                ],
                [
                  152.15,
                  -32.98
                ],
                [
                  152.15,
                  -34.25
                ],
                [
                  150.55,
                  -34.25
                ],
                [
                  150.55,
                  -32.98
                ]
              ]
            ]
          }
        }
      },
      "layer": [
        {
          "data": {
            "url": "data/nsw_lga.geojson",
            "format": {
              "type": "json",
              "property": "features"
            }
          },
          "transform": [
            {
              "filter": "datum.properties.lga_name !== \"Lord Howe Island (unincorporated)\""
            }
          ],
          "mark": {
            "type": "geoshape",
            "fill": "#F1F2EE",
            "stroke": "#C9CFCB",
            "strokeWidth": 0.5,
            "clip": true
          }
        },
        {
          "name": "dotAreasInset",
          "data": {
            "url": "data/rescue_counts_by_lga.csv",
            "format": {
              "type": "csv",
              "parse": {
                "financial_year": "string",
                "rescue_count": "number"
              }
            }
          },
          "transform": [
            {
              "filter": "datum.financial_year === \"2024/25\" && datum.lga_name !== \"LGA not recorded\" && datum.lga_name !== \"Lord Howe Island (unincorporated)\""
            },
            {
              "calculate": "round(datum.rescue_count / 25)",
              "as": "dots"
            },
            {
              "lookup": "lga_name",
              "from": {
                "data": {
                  "url": "data/nsw_lga.geojson",
                  "format": {
                    "type": "json",
                    "property": "features"
                  }
                },
                "key": "properties.lga_name"
              },
              "as": "geo"
            }
          ],
          "mark": {
            "type": "geoshape",
            "fill": "#F1F2EE",
            "clip": true
          },
          "encoding": {
            "shape": {
              "field": "geo",
              "type": "geojson"
            },
            "stroke": {
              "condition": {
                "param": "area_hover",
                "empty": false,
                "value": "#25332F"
              },
              "value": "#C9CFCB"
            },
            "strokeWidth": {
              "condition": {
                "param": "area_hover",
                "empty": false,
                "value": 1.6
              },
              "value": 0.5
            },
            "tooltip": [
              {
                "field": "lga_name",
                "type": "nominal",
                "title": "Council area"
              },
              {
                "field": "rescue_count",
                "type": "quantitative",
                "title": "Rescues 2024–25",
                "format": ","
              },
              {
                "field": "dots",
                "type": "quantitative",
                "title": "Dots shown (rounded)"
              }
            ]
          }
        },
        {
          "data": {
            "url": "data/rescue_dots_2024_25.csv",
            "format": {
              "type": "csv",
              "parse": {
                "lon": "number",
                "lat": "number"
              }
            }
          },
          "transform": [
            {
              "filter": "datum.lon >= 150.55 && datum.lon <= 152.15 && datum.lat <= -32.98 && datum.lat >= -34.25"
            }
          ],
          "mark": {
            "type": "circle",
            "size": 3,
            "color": "#0B4A42",
            "opacity": 0.6,
            "clip": true
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            }
          }
        }
      ]
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Atkinson Hyperlegible, system-ui, sans-serif",
    "title": {
      "fontSize": 14,
      "fontWeight": 600,
      "color": "#25332F",
      "subtitleFontSize": 11.5,
      "subtitleColor": "#5E6B63",
      "offset": 8
    },
    "concat": {
      "spacing": 24
    }
  }
}
