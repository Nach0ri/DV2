{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional symbol map: rescues per NSW council area in 2024-25 (circle area) and whether they rose or fell since 2018-19 (colour). Source: NSW DCCEEW Wildlife Rehabilitation Data Dashboard.",
  "data": {
    "url": "data/rescue_counts_by_lga.csv",
    "format": {
      "type": "csv",
      "parse": {
        "financial_year": "string",
        "rescue_count": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.lga_name !== 'LGA not recorded'"
    },
    {
      "filter": {
        "field": "financial_year",
        "oneOf": [
          "2018/19",
          "2024/25"
        ]
      }
    },
    {
      "pivot": "financial_year",
      "value": "rescue_count",
      "groupby": [
        "lga_name"
      ]
    },
    {
      "calculate": "datum['2024/25']",
      "as": "now"
    },
    {
      "calculate": "datum['2018/19']",
      "as": "before"
    },
    {
      "filter": "isValid(datum.now) && isValid(datum.before) && datum.now > 0"
    },
    {
      "calculate": "datum.now - datum.before",
      "as": "change"
    },
    {
      "calculate": "datum.before > 0 ? datum.change / datum.before : null",
      "as": "change_pct"
    },
    {
      "calculate": "datum.change > 0 ? 'Rose' : datum.change < 0 ? 'Fell' : 'Same'",
      "as": "direction"
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "now",
          "order": "descending"
        }
      ]
    },
    {
      "calculate": "datum.lga_name + '  ' + format(datum.now, ',')",
      "as": "label"
    },
    {
      "lookup": "lga_name",
      "from": {
        "data": {
          "url": "data/nsw_lga.geojson",
          "format": {
            "type": "json",
            "property": "features"
          }
        },
        "key": "properties.lga_name",
        "fields": [
          "properties.lx",
          "properties.ly"
        ]
      },
      "as": [
        "lx",
        "ly"
      ]
    },
    {
      "calculate": "datum.lx >= 150.55 && datum.lx <= 152.15 && datum.ly <= -32.98 && datum.ly >= -34.25",
      "as": "in_inset"
    }
  ],
  "params": [
    {
      "name": "dir_pick",
      "select": {
        "type": "point",
        "fields": [
          "direction"
        ]
      },
      "bind": "legend",
      "views": [
        "symMain",
        "symInset"
      ]
    }
  ],
  "hconcat": [
    {
      "width": 540,
      "height": 400,
      "title": {
        "text": "Rescues by council area, 2024–25",
        "subtitle": "Circle area = rescues. Colour = change since 2018–19. Labels mark the top five.",
        "anchor": "start"
      },
      "projection": {
        "type": "conicEqualArea",
        "rotate": [
          -147,
          0
        ],
        "parallels": [
          -29,
          -36
        ],
        "fit": {
          "type": "Feature",
          "properties": {},
          "geometry": {
            "type": "Polygon",
            "coordinates": [
              [
                [
                  140.9,
                  -28.1
                ],
                [
                  153.7,
                  -28.1
                ],
                [
                  153.7,
                  -37.6
                ],
                [
                  140.9,
                  -37.6
                ],
                [
                  140.9,
                  -28.1
                ]
              ]
            ]
          }
        }
      },
      "layer": [
        {
          "data": {
            "url": "data/nsw_lga.geojson",
            "format": {
              "type": "json",
              "property": "features"
            }
          },
          "transform": [
            {
              "filter": "datum.properties.lga_name !== 'Lord Howe Island (unincorporated)'"
            }
          ],
          "mark": {
            "type": "geoshape",
            "fill": "#EDEFEA",
            "stroke": "#FFFFFF",
            "strokeWidth": 0.6
          }
        },
        {
          "data": {
            "values": [
              {
                "type": "Feature",
                "properties": {},
                "geometry": {
                  "type": "Polygon",
                  "coordinates": [
                    [
                      [
                        150.55,
                        -32.98
                      ],
                      [
                        152.15,
                        -32.98
                      ],
                      [
                        152.15,
                        -34.25
                      ],
                      [
                        150.55,
                        -34.25
                      ],
                      [
                        150.55,
                        -32.98
                      ]
                    ]
                  ]
                }
              }
            ]
          },
          "mark": {
            "type": "geoshape",
            "filled": false,
            "stroke": "#25332F",
            "strokeWidth": 1.1,
            "strokeDash": [
              4,
              3
            ]
          }
        },
        {
          "name": "symMain",
          "mark": {
            "type": "circle",
            "stroke": "#FFFFFF",
            "strokeWidth": 0.8
          },
          "encoding": {
            "longitude": {
              "field": "lx",
              "type": "quantitative"
            },
            "latitude": {
              "field": "ly",
              "type": "quantitative"
            },
            "size": {
              "field": "now",
              "type": "quantitative",
              "title": "Rescues, 2024–25",
              "scale": {
                "type": "linear",
                "zero": true,
                "domain": [
                  0,
                  5200
                ],
                "range": [
                  0,
                  1400
                ]
              },
              "legend": {
                "values": [
                  500,
                  2000,
                  5000
                ],
                "labelExpr": "format(datum.value, \",\")",
                "symbolFillColor": "#B9C1BD",
                "symbolStrokeColor": "#5E6B63",
                "symbolOpacity": 0.7,
                "orient": "right"
              }
            },
            "color": {
              "field": "direction",
              "type": "nominal",
              "title": "Since 2018–19",
              "scale": {
                "domain": [
                  "Rose",
                  "Same",
                  "Fell"
                ],
                "range": [
                  "#A0286C",
                  "#9DAAA4",
                  "#8FA0A9"
                ]
              },
              "legend": {
                "symbolType": "circle",
                "symbolOpacity": 0.8,
                "orient": "right"
              }
            },
            "fillOpacity": {
              "condition": {
                "param": "dir_pick",
                "value": 0.62
              },
              "value": 0.06
            },
            "strokeOpacity": {
              "condition": {
                "param": "dir_pick",
                "value": 1
              },
              "value": 0.1
            },
            "order": {
              "field": "now",
              "sort": "descending"
            },
            "tooltip": [
              {
                "field": "lga_name",
                "type": "nominal",
                "title": "Council area"
              },
              {
                "field": "now",
                "type": "quantitative",
                "title": "Rescues 2024–25",
                "format": ","
              },
              {
                "field": "before",
                "type": "quantitative",
                "title": "Rescues 2018–19",
                "format": ","
              },
              {
                "field": "change",
                "type": "quantitative",
                "title": "Change (author-calculated)",
                "format": "+,"
              },
              {
                "field": "change_pct",
                "type": "quantitative",
                "title": "Change % (author-calculated)",
                "format": "+.0%"
              },
              {
                "field": "rank",
                "type": "quantitative",
                "title": "Rank in 2024–25"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum.rank <= 5 && !datum.in_inset"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 12,
            "fontSize": 11,
            "fontWeight": 600,
            "color": "#25332F",
            "stroke": "#FFFFFF",
            "strokeWidth": 3,
            "strokeOpacity": 0.85
          },
          "encoding": {
            "longitude": {
              "field": "lx",
              "type": "quantitative"
            },
            "latitude": {
              "field": "ly",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.rank <= 5 && !datum.in_inset"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 12,
            "fontSize": 11,
            "fontWeight": 600,
            "color": "#25332F"
          },
          "encoding": {
            "longitude": {
              "field": "lx",
              "type": "quantitative"
            },
            "latitude": {
              "field": "ly",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        }
      ]
    },
    {
      "width": 260,
      "height": 320,
      "title": {
        "text": "Sydney and Central Coast",
        "subtitle": "Close-up of the dashed box (same circle scale)",
        "anchor": "start"
      },
      "transform": [
        {
          "filter": "datum.in_inset"
        }
      ],
      "projection": {
        "type": "conicEqualArea",
        "rotate": [
          -147,
          0
        ],
        "parallels": [
          -29,
          -36
        ],
        "fit": {
          "type": "Feature",
          "properties": {},
          "geometry": {
            "type": "Polygon",
            "coordinates": [
              [
                [
                  150.55,
                  -32.98
                ],
                [
                  152.15,
                  -32.98
                ],
                [
                  152.15,
                  -34.25
                ],
                [
                  150.55,
                  -34.25
                ],
                [
                  150.55,
                  -32.98
                ]
              ]
            ]
          }
        }
      },
      "layer": [
        {
          "data": {
            "url": "data/nsw_lga.geojson",
            "format": {
              "type": "json",
              "property": "features"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": "#EDEFEA",
            "stroke": "#FFFFFF",
            "strokeWidth": 0.6,
            "clip": true
          }
        },
        {
          "name": "symInset",
          "mark": {
            "type": "circle",
            "stroke": "#FFFFFF",
            "strokeWidth": 0.8,
            "clip": true
          },
          "encoding": {
            "longitude": {
              "field": "lx",
              "type": "quantitative"
            },
            "latitude": {
              "field": "ly",
              "type": "quantitative"
            },
            "size": {
              "field": "now",
              "type": "quantitative",
              "scale": {
                "type": "linear",
                "zero": true,
                "domain": [
                  0,
                  5200
                ],
                "range": [
                  0,
                  1400
                ]
              },
              "legend": null
            },
            "color": {
              "field": "direction",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Rose",
                  "Same",
                  "Fell"
                ],
                "range": [
                  "#A0286C",
                  "#9DAAA4",
                  "#8FA0A9"
                ]
              },
              "legend": null
            },
            "fillOpacity": {
              "condition": {
                "param": "dir_pick",
                "value": 0.62
              },
              "value": 0.06
            },
            "strokeOpacity": {
              "condition": {
                "param": "dir_pick",
                "value": 1
              },
              "value": 0.1
            },
            "order": {
              "field": "now",
              "sort": "descending"
            },
            "tooltip": [
              {
                "field": "lga_name",
                "type": "nominal",
                "title": "Council area"
              },
              {
                "field": "now",
                "type": "quantitative",
                "title": "Rescues 2024–25",
                "format": ","
              },
              {
                "field": "before",
                "type": "quantitative",
                "title": "Rescues 2018–19",
                "format": ","
              },
              {
                "field": "change",
                "type": "quantitative",
                "title": "Change (author-calculated)",
                "format": "+,"
              },
              {
                "field": "change_pct",
                "type": "quantitative",
                "title": "Change % (author-calculated)",
                "format": "+.0%"
              },
              {
                "field": "rank",
                "type": "quantitative",
                "title": "Rank in 2024–25"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum.rank <= 5"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 12,
            "fontSize": 11,
            "fontWeight": 600,
            "color": "#25332F",
            "stroke": "#FFFFFF",
            "strokeWidth": 3,
            "strokeOpacity": 0.85
          },
          "encoding": {
            "longitude": {
              "field": "lx",
              "type": "quantitative"
            },
            "latitude": {
              "field": "ly",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.rank <= 5"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 12,
            "fontSize": 11,
            "fontWeight": 600,
            "color": "#25332F"
          },
          "encoding": {
            "longitude": {
              "field": "lx",
              "type": "quantitative"
            },
            "latitude": {
              "field": "ly",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        }
      ]
    }
  ],
  "resolve": {
    "scale": {
      "size": "shared",
      "color": "shared"
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Atkinson Hyperlegible, system-ui, sans-serif",
    "title": {
      "fontSize": 14,
      "fontWeight": 600,
      "color": "#25332F",
      "subtitleFontSize": 11.5,
      "subtitleColor": "#5E6B63",
      "offset": 8
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleFontWeight": 700,
      "labelColor": "#25332F",
      "titleColor": "#25332F",
      "titleLimit": 220
    },
    "concat": {
      "spacing": 24
    }
  }
}
